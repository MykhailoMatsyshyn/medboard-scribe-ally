# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
# .env.local is git-ignored — never commit real values.
# ─────────────────────────────────────────────────────────────

# Client-side (Vite) — safe to expose in the browser bundle.
# Only variables prefixed with VITE_ are readable by the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Server-side only — DO NOT prefix with VITE_ and never ship to
# the browser. These are configured as Supabase Edge Function
# secrets (supabase secrets set ...), not read by the frontend.
#   OPENROUTER_API_KEY   – OpenRouter API key
#   OPENROUTER_MODEL     – model slug, e.g. openai/gpt-4o-mini (must support tool-calling)
# ─────────────────────────────────────────────────────────────
